    1: """
       ast_nodes.py
       ------------
       The Abstract Syntax Tree (AST) node types produced by the parser and
       consumed by the evaluator.
       
       Using @dataclass gives each node value-based equality "for free" (two
       Number(2) instances compare equal), which is what makes the parser
       tests readable -- a test can assert `parse("2+3") == BinaryOp("+",
       Number(2), Number(3))` instead of manually walking the tree.
       """
       
    1: from __future__ import annotations
       
    1: from dataclasses import dataclass
    1: from typing import Union
       
       
    3: @dataclass
    2: class Number:
    1:     """A literal numeric value, e.g. the `5` in `5 + 1`."""
    1:     value: float
       
       
    3: @dataclass
    2: class UnaryOp:
    1:     """A prefix operator applied to a single operand, e.g. `-5` or `+5`."""
    1:     op: str  # '-' or '+'
    1:     operand: "ASTNode"
       
       
    3: @dataclass
    2: class BinaryOp:
    1:     """An infix operator applied to two operands, e.g. `2 + 3`."""
    1:     op: str  # '+', '-', '*', '/', '%', or '**'
    1:     left: "ASTNode"
    1:     right: "ASTNode"
       
       
    1: ASTNode = Union[Number, UnaryOp, BinaryOp]
